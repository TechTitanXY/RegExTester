<Window x:Class="RegExTester.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RegExTester"
        mc:Ignorable="d"
        Title="Regex Tester by Phillip Galey" Height="600" Width="800">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Pattern Label -->
            <RowDefinition Height="Auto"/> <!-- Pattern TextBox -->
            <RowDefinition Height="Auto"/> <!-- Test Text Label -->
            <RowDefinition Height="*"/>    <!-- Editable RichTextBox -->
            <RowDefinition Height="Auto"/> <!-- Preview Label -->
            <RowDefinition Height="*"/>    <!-- Preview RichTextBox -->
            <RowDefinition Height="Auto"/> <!-- MatchResult -->
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Regular Expression Pattern:" FontWeight="Bold" Margin="0,0,0,5"/>

        <TextBox Grid.Row="1" Text="{Binding Pattern, UpdateSourceTrigger=PropertyChanged}" 
                 Margin="0,0,0,10" />

        <TextBlock Grid.Row="2" Text="Test Text:" FontWeight="Bold" Margin="0,0,0,5"/>

        <RichTextBox Grid.Row="3" x:Name="TestRichTextBox" Margin="0,0,0,10"
                     VerticalScrollBarVisibility="Auto"
                     TextChanged="TestRichTextBox_TextChanged" />

        <TextBlock Grid.Row="4" Text="Highlighted Preview:" FontWeight="Bold" Margin="0,6,0,5"/>

        <!-- Read-only preview; caret and selection unaffected -->
        <RichTextBox Grid.Row="5" x:Name="PreviewRichTextBox" Margin="0,0,0,10"
                     VerticalScrollBarVisibility="Auto"
                     IsReadOnly="True"
                     Focusable="False"
                     IsDocumentEnabled="False"/>

        <TextBlock Grid.Row="6" Text="{Binding MatchResult}" Foreground="DarkGreen" Margin="0,10,0,0"/>
    </Grid>
</Window>
